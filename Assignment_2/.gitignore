# Applies to all three applications (diabetes/, house_price/, customer_behavior/).

# --- raw data (large Kaggle CSVs; not committed — see each app's data/README.md) ---
*/data/*.csv
*/data/*.zip

# --- trained pipeline artifacts (regenerated by each app's notebook, section 22) ---
*/model/*.joblib
*/model/*.pkl
*/model/holdout_scores.joblib
# each app's model/input_schema.json IS committed — the graded input contract.
!*/model/input_schema.json

# --- python ---
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
*/api/artifacts/

# --- node (web/) ---
*/web/node_modules/
*/web/dist/
*/web/.vite/

# --- flutter / capacitor (mobile/) ---
*/mobile/node_modules/
*/mobile/android/.gradle/
*/mobile/android/build/
*/mobile/android/app/build/
*/mobile/android/local.properties
*/mobile/ios/App/Pods/
*/mobile/ios/App/build/
*/mobile/dist/

# --- report build artifacts ---
report/*.aux
report/*.log
report/*.out
report/*.toc

# --- local scratch (not part of the deliverable) ---
_scratch/

# --- OS ---
.DS_Store
